         std::env::var("CARGO_CFG_TARGET_ARCH").unwrap_or_default();
     let target_os = std::env::var("CARGO_CFG_TARGET_OS").unwrap_or_default();
 
+    // z/OS: use pre-built static library from zopen community
+    if target_os == "zos" {
+        let lib_dir = env::var("ZSTD_LIB_DIR")
+            .unwrap_or_else(|_| "/tmp/zos-sysroot/zstd/lib".to_string());

+            .unwrap_or_else(|_| "/tmp/zos-sysroot/zstd/include".to_string());
+        cargo_print(&format!("rustc-link-search=native={}", lib_dir));
+        cargo_print(&"rustc-link-lib=static=zstd");
+        cargo_print(&format!("include={}", include_dir));
+        return;
+    }
+
     if target_arch == "wasm32" || target_os == "hermit" {
         cargo_print(&"rustc-cfg=feature=\"std\"");
     }

+/* z/OS uint128 compatibility
+ * IBM XL C does not support __int128_t or __uint128_t.
+ * This header provides a compatible typedef and required arithmetic operations.
+ */
+#pragma once
+#ifdef __MVS__
+#include <stdint.h>
+
+typedef struct { uint64_t lo; uint64_t hi; } __uint128_zos;
+#define __uint128_t __uint128_zos
+
+/* Cast from uint64_t to uint128 */
+#define CAST128(x) ((__uint128_zos){(uint64_t)(x), 0})
+
+/* 64x64->128 multiply (used by ring) */
+static inline __uint128_zos mul128(uint64_t a, uint64_t b) {
+    uint32_t a0 = (uint32_t)a, a1 = (uint32_t)(a >> 32);
+    uint32_t b0 = (uint32_t)b, b1 = (uint32_t)(b >> 32);
+    uint64_t p0 = (uint64_t)a0 * b0;
+    uint64_t p1 = (uint64_t)a0 * b1;
+    uint64_t p2 = (uint64_t)a1 * b0;
+    uint64_t p3 = (uint64_t)a1 * b1;
+    uint64_t mid = (p0 >> 32) + (uint32_t)p1 + (uint32_t)p2;
+    __uint128_zos r;
+    r.lo = ((uint64_t)(uint32_t)p0) | (mid << 32);
+    r.hi = p3 + (p1 >> 32) + (p2 >> 32) + (mid >> 32);
+    return r;
+}
+
+#endif /* __MVS__ */

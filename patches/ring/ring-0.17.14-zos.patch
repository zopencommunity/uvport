+/* bn_mul_mont_zos.c - Software Montgomery multiplication for platforms
+ * without assembly support (e.g. z/OS big-endian s390x, other non-x86/arm).
+ *
+ * On these platforms, the #else branch of bn_mul_mont_small calls bn_mul_mont,
+ * which has no C definition otherwise.
+ *
+ * Implements: rp = ap * bp * R^{-1} mod np
+ * Algorithm: Separated Operand Scanning (SOS), Koc et al. 1996.
+ *
+ * Supports arbitrary num up to BN_MONTGOMERY_MAX_WORDS (1024 words).
+ */
+
+#include "internal.h"
+#include <stdlib.h>
+
+#if defined(OPENSSL_SMALL)
+
+void bn_mul_mont(BN_ULONG *rp, const BN_ULONG *ap, const BN_ULONG *bp,
+                 const BN_ULONG *np, const BN_ULONG *n0p, size_t num) {
+  /* Allocate temporary array t[2*num+1] on the stack for small num,
+   * heap for large num (RSA-2048 uses num=32, RSA-4096 uses num=64). */
+#define BN_MONT_MAX_STACK 128  /* words; up to RSA-4096 comfortably on stack */
+  BN_ULONG t_stack[BN_MONT_MAX_STACK * 2 + 1];
+  BN_ULONG *t;
+  int heap_alloc = 0;
+
+  if (num == 0) return;
+
+  size_t t_size = 2 * num + 1;
+  if (t_size <= BN_MONT_MAX_STACK * 2 + 1) {
+    t = t_stack;
+  } else {
+    t = (BN_ULONG *)malloc(t_size * sizeof(BN_ULONG));
+    if (!t) return;
+    heap_alloc = 1;
+  }
+
+  BN_ULONG n0 = n0p[0];
+  size_t i;
+
+  /* Zero t */
+  for (i = 0; i < t_size; i++) t[i] = 0;
+
+  /* ---- Phase 1: t[0..2*num-1] = ap * bp ---- */
+  for (i = 0; i < num; i++) {
+    BN_ULONG ai = ap[i];
+    BN_ULONG carry = 0;
+    size_t j;
+    for (j = 0; j < num; j++) {
+      BN_ULONG lo, hi;
+      bn_umult_lohi(&lo, &hi, ai, bp[j]);
+
+      BN_ULONG sum = t[i + j] + lo;
+      BN_ULONG c1 = (sum < t[i + j]) ? 1 : 0;
+      sum += carry;
+      BN_ULONG c2 = (sum < carry) ? 1 : 0;
+      t[i + j] = sum;
+      carry = hi + c1 + c2;
+    }
+    /* Carry into t[i+num]; safe since t has 2*num+1 words */
+    t[i + num] += carry;
+  }
+
+  /* ---- Phase 2: Montgomery reduction ---- */
+  for (i = 0; i < num; i++) {
+    BN_ULONG m = t[i] * n0;   /* reduction factor for this step */
+    BN_ULONG carry = 0;
+    size_t j;
+    for (j = 0; j < num; j++) {
+      BN_ULONG lo, hi;
+      bn_umult_lohi(&lo, &hi, m, np[j]);
+
+      BN_ULONG sum = t[i + j] + lo;
+      BN_ULONG c1 = (sum < t[i + j]) ? 1 : 0;
+      sum += carry;
+      BN_ULONG c2 = (sum < carry) ? 1 : 0;
+      t[i + j] = sum;
+      carry = hi + c1 + c2;
+    }
+    /* Propagate carry into upper words */
+    size_t k = i + num;
+    while (carry) {
+      BN_ULONG s = t[k] + carry;
+      carry = (s < t[k]) ? 1 : 0;
+      t[k] = s;
+      k++;
+    }
+    /* t[i] is now 0 mod 2^BITS by construction */
+    t[i] = 0;
+  }
+
+  /* ---- Phase 3: rp = t[num..2*num-1], subtract np if needed ---- */
+  BN_ULONG *res = &t[num];
+  BN_ULONG overflow = t[2 * num];
+
+  /* Attempt conditional subtraction: sub[] = res[] - np */
+  BN_ULONG *sub = t;  /* reuse the now-zeroed low half of t */
+  BN_ULONG borrow = 0;
+  for (i = 0; i < num; i++) {
+    BN_ULONG r_i = res[i];
+    BN_ULONG s = r_i - np[i];
+    BN_ULONG b1 = (s > r_i) ? 1 : 0;
+    s -= borrow;
+    BN_ULONG b2 = (borrow > 0 && s == (BN_ULONG)(-1)) ? 1 : 0;
+    borrow = b1 | b2;
+    sub[i] = s;
+  }
+
+  /* Use sub[] if overflow > 0 (means res >= 2*np, definitely reduce)
+   * OR if borrow == 0 (subtraction didn't underflow, res >= np). */
+  BN_ULONG use_sub = (overflow > 0 || borrow == 0) ? 1 : 0;
+  for (i = 0; i < num; i++) {
+    rp[i] = use_sub ? sub[i] : res[i];
+  }
+
+  if (heap_alloc) {
+    free(t);
+  }
+}
+
+#endif  /* OPENSSL_SMALL */

-    pub async fn start(mut self) {
-        loop {
-            match self.listener.accept().await {
-                Ok((stream, _)) => {
-                    match self.handle_connection(stream).await {
-                        Ok(_) => (),
-                        Err(e) => {
-                            println!("Error handling connection: {}", e);
-                        }

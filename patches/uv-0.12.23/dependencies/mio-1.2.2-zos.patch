+#[cfg(not(any(target_os = "horizon", target_os = "wasi")))]
+impl std::os::fd::AsFd for Selector {
+    fn as_fd(&self) -> std::os::fd::BorrowedFd<'_> {
+        // Use the notify waker pipe fd as the selector's fd
+        let raw = self.state.fds.lock().unwrap()
+            .poll_fds.first()
+            .map(|pf| pf.0.fd)
+            .unwrap_or(-1);
+        unsafe { std::os::fd::BorrowedFd::borrow_raw(raw) }
+    }
+}
+
+#[cfg(not(any(target_os = "horizon", target_os = "wasi")))]
+impl std::os::fd::AsRawFd for Selector {
+    fn as_raw_fd(&self) -> std::os::fd::RawFd {
+        self.state.fds.lock().unwrap()
+            .poll_fds.first()
+            .map(|pf| pf.0.fd)
+            .unwrap_or(-1)
+    }
+}

+fn test_haiku(target: &str) {
+    assert!(target.contains("haiku"));
+
+    let mut cfg = ctest_cfg();
+    cfg.flag("-Wno-deprecated-declarations");
+    cfg.define("__USE_GNU", Some("1"));
+    cfg.define("_GNU_SOURCE", None);
+    cfg.language(ctest::Lang::CXX);
+
+    // POSIX API
